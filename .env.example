# ──────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is git-ignored — never commit real API keys.
# ──────────────────────────────────────────────────────────────────────

# Which agent backend to run.
#   adk       -> Google ADK agent, uses Gemini (has a free quota)
#   langgraph -> LangGraph deep_agent, uses OpenAI
# Note: L6 does not support "adk" — use "langgraph" (+ gemini) there instead,
# via MODEL_PROVIDER (see that lesson's run_agent.py / README for details).
AGENT_TYPE=adk

# ── OpenAI ───────────────────────────────────────────────────────────
# Required when AGENT_TYPE=langgraph.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model used for OpenAI-backed lessons.
# A few lessons don't support gpt-5.6-luna's reasoning output format —
# use gpt-5.4-mini there instead (see each lesson's README).
OPENAI_MODEL=gpt-5.6-luna

# ── Google Gemini ────────────────────────────────────────────────────
# Required when AGENT_TYPE=adk.
# Get a free-quota key at: https://aistudio.google.com/apikey
# IMPORTANT: the code reads GOOGLE_API_KEY (not GEMINI_API_KEY) —
# use this exact variable name.
GOOGLE_API_KEY=your-google-api-key-here

# Model used for Gemini-backed lessons (gemini-3.5-flash-lite is on the free quota).
GEMINI_MODEL=gemini-3.5-flash-lite
